[Unit]
Description=Verify real OneBookUI compositor and shell in headless QEMU
Requires=onebook-headless.service
After=onebook-headless.service
ConditionKernelCommandLine=obos.test=1

[Service]
Type=oneshot
ExecStart=/usr/local/bin/onebook-gui-smoke
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
