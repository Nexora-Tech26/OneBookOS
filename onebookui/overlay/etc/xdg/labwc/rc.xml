<?xml version="1.0" encoding="utf-8"?>
<labwc_config>
 <theme><name>Default</name><cornerRadius>10</cornerRadius></theme>
 <keyboard>
  <keybind key="A-F4"><action name="Close"/></keybind>
  <keybind key="A-Tab"><action name="NextWindow"/></keybind>
  <keybind key="W-Return"><action name="Execute" command="xterm"/></keybind>
  <keybind key="W-e"><action name="Execute" command="/usr/local/bin/onebook-files"/></keybind>
 </keyboard>
</labwc_config>
