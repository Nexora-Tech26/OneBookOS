#!/usr/bin/env bash
set -Eeuo pipefail
COMPOSITOR=labwc
if grep -qE '(^|[[:space:]])obos\.compositor=wayfire([[:space:]]|$)' /proc/cmdline; then
  COMPOSITOR=wayfire
fi
printf '%s\n' 'ONEBOOK_TEST_SERVICE_STARTED' > /dev/ttyS0
SOCK='/run/onebookui-smoke/wayland-0'
READY='/run/onebookui-smoke/onebook-shell-ready'
ok=0
# Fail early on compositor crash. A simple boot to the login prompt is NEVER success.
for _ in $(seq 1 170); do
  if pgrep -u obos -x "$COMPOSITOR" >/dev/null && \
     pgrep -u obos -f '/usr/local/bin/onebook-shell' >/dev/null && \
     test -S "$SOCK" && test -s "$READY"; then
    ok=1
    break
  fi
  if systemctl is-failed --quiet onebook-headless.service; then
    echo 'ONEBOOK_HEADLESS_SERVICE_FAILED' > /dev/ttyS0
    break
  fi
  sleep 1
done
if test "$ok" -eq 1; then
  # Real compositor, socket and shell must remain live, not just start once.
  for _ in $(seq 1 25); do
    if ! pgrep -u obos -x "$COMPOSITOR" >/dev/null || \
       ! pgrep -u obos -f '/usr/local/bin/onebook-shell' >/dev/null || \
       ! test -S "$SOCK" || ! test -s "$READY"; then
      ok=0
      break
    fi
    sleep 1
  done
fi
if test "$ok" -eq 1; then
  echo ONEBOOK_WAYLAND_GUI_OK > /dev/ttyS0
  exit 0
fi
{
  echo ONEBOOK_WAYLAND_GUI_FAILED
  echo '--- systemd headless session status ---'
  systemctl --no-pager -l status onebook-headless.service || true
  echo '--- compositor journal ---'
  journalctl -b -u onebook-headless.service --no-pager -n 120 || true
  echo '--- compositor and shell stderr ---'
  tail -n 120 /tmp/onebook-session.log || true
  tail -n 120 /tmp/onebook-shell.log || true
  echo '--- runtime objects ---'
  ls -lah /run/onebookui-smoke || true
  echo '--- user and processes ---'
  id obos || true
  pgrep -a -f 'labwc|onebook-shell|onebook-session|greetd' || true
} > /dev/ttyS0 2>&1
exit 1
