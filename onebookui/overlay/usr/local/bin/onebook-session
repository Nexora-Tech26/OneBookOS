#!/usr/bin/env bash
# OneBookUI session runner shared by greetd and headless CI.
set -Eeuo pipefail
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=OneBookUI
export XDG_SESSION_DESKTOP=onebookui
export GDK_BACKEND=wayland
export GTK_THEME=OneBookUI
# Keep custom GTK3 shell sizing at logical pixels; let Wayland output scale separately.
export XCURSOR_SIZE=22
if grep -qE '(^|[[:space:]])obos\.test=1([[:space:]]|$)' /proc/cmdline; then
  export WLR_BACKENDS=headless
  export WLR_HEADLESS_OUTPUTS=1
  export WLR_RENDERER=pixman
  export WLR_LIBINPUT_NO_DEVICES=1
fi
# Save actual compositor stderr. The QEMU smoke check prints this on failures.
{
  printf '[OneBookSession] user=%s runtime=%s backend=%s\n' "$(id -un)" "${XDG_RUNTIME_DIR:-unset}" "${WLR_BACKENDS:-auto}"
  if grep -qE '(^|[[:space:]])obos\\.compositor=wayfire([[:space:]]|$)' /proc/cmdline; then
    compositor=wayfire
  else
    compositor=labwc
  fi
  printf '[OneBookSession] starting %s compositor\n' "$compositor"
} >> /tmp/onebook-session.log
if [[ "$compositor" == wayfire ]]; then
  # Wayfire is experimental: unlike labwc it requires a working EGL/GL path.
  # Headless software rendering is not assumed to be supported.
  exec dbus-run-session -- wayfire --config /etc/xdg/wayfire.ini >> /tmp/onebook-session.log 2>&1
fi
exec dbus-run-session -- labwc >> /tmp/onebook-session.log 2>&1
