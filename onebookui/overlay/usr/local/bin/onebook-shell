.menu-section { color: #e8efff; font-size: 13px; font-weight: 700; margin-top: 5px; }
.menu-divider { background: rgba(240,244,255,.12); min-height: 1px; margin: 2px 0 6px 0; }
.menu searchentry, .menu entry { background-image: none; background-color: rgba(239,244,255,.13); color: #ffffff; border: 1px solid rgba(255,255,255,.14); border-radius: 15px; padding: 10px 13px; min-height: 24px; box-shadow: none; caret-color: white; }
.menu searchentry:focus, .menu entry:focus { border-color: #83a8ff; }
