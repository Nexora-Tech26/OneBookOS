"""

def styled(widget, cls):
    widget.get_style_context().add_class(cls)
    return widget

def spawn(argv):
    try:
        subprocess.Popen(argv, start_new_session=True)
    except OSError as exc:
        print("OneBookUI launch error:", exc, flush=True)

def read_cmd(argv):
    try:
        return subprocess.check_output(argv, text=True, stderr=subprocess.DEVNULL, timeout=2).strip()
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return ""

def icon(name, size=24):
    # Rasterize the source SVG at the requested size; avoid upscaling 64px pixmaps.
    path = ICON_DIR / (name + ".svg")
    if path.is_file():
        try:
            picture = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), size, size, True)
            return Gtk.Image.new_from_pixbuf(picture)
        except GLib.Error as exc:
            print("OneBookUI icon failed:", path, exc, flush=True)
    return Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.BUTTON)

def layer_window(layer, edges, margin=0, keyboard=False):
    w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    w.set_decorated(False)
    w.set_resizable(False)
    w.set_app_paintable(True)
    rgba = w.get_screen().get_rgba_visual()
    if rgba is not None:
        w.set_visual(rgba)
    GtkLayerShell.init_for_window(w)
    GtkLayerShell.set_layer(w, layer)
    for edge in edges:
        GtkLayerShell.set_anchor(w, edge, True)
        GtkLayerShell.set_margin(w, edge, margin)
    if keyboard:
        GtkLayerShell.set_keyboard_mode(w, GtkLayerShell.KeyboardMode.ON_DEMAND)
    return w

def button(child, callback, cls="launcher", tip=None):
    b = styled(Gtk.Button(), cls)
    b.add(child)
    b.connect("clicked", lambda _b: callback())
    if tip:
        b.set_tooltip_text(tip)
    return b

class Desktop:
    def __init__(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.ready = False
        self.volume_updating = False
        self.menu_visible = False
        self.notch_close_id = 0
        self.create_dock()
        self.create_desktop_shortcuts()
        self.create_clock()
        self.create_notch()
        self.create_menu()
        self.dock.show_all()
        self.desktop.show_all()
        self.clock_win.show_all()
        self.notch_win.show_all()
        self.menu_win.hide()
        GLib.timeout_add_seconds(1, self.tick)
        GLib.timeout_add(1800, self.mark_ready)
        # During QEMU screenshot QA, display the real launcher for visual inspection.
        if "obos.gui-test=1" in Path("/proc/cmdline").read_text(encoding="utf-8"):
            GLib.timeout_add(5000, self.preview_menu_for_qa)

    def create_dock(self):
        # One continuous connected dock. The middle Start remains the exact center.
        self.dock = layer_window(GtkLayerShell.Layer.TOP, [GtkLayerShell.Edge.BOTTOM], 18)
        outer = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2), "dock-shell")
        left = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2), "dock-segment")
        right = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2), "dock-segment")
        for name, label, command in [
            ("files", "Files", ["thunar"]), ("terminal", "Terminal", ["foot"]),
        ]:
            control = button(icon(name, 27), lambda c=command: spawn(c), tip=label)
            control.set_size_request(47, 47)
            left.pack_start(control, False, False, 0)
        self.start_btn = button(icon("onebook", 28), self.toggle_menu, "start", "Start")
        self.start_btn.set_size_request(50, 50)
        for name, label, command in [
            ("settings", "Connections", ["nm-connection-editor"]),
            ("monitor", "System monitor", ["foot", "-e", "top"]),
        ]:
            control = button(icon(name, 27), lambda c=command: spawn(c), tip=label)
            control.set_size_request(47, 47)
            right.pack_start(control, False, False, 0)
        outer.pack_start(left, False, False, 0)
        outer.pack_start(styled(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), "dock-separator"), False, False, 0)
        outer.pack_start(self.start_btn, False, False, 0)
        outer.pack_start(styled(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), "dock-separator"), False, False, 0)
        outer.pack_start(right, False, False, 0)
        self.dock.add(outer)
        GtkLayerShell.auto_exclusive_zone_enable(self.dock)

    def create_desktop_shortcuts(self):
        self.desktop = layer_window(
            GtkLayerShell.Layer.BOTTOM,
            [GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT], 27
        )
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        for name, title, command in [
            ("files", "Files", ["thunar"]),
            ("terminal", "Terminal", ["foot"]),
            ("notes", "Notes", ["mousepad"]),
            ("settings", "Network", ["nm-connection-editor"]),
        ]:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            tile.pack_start(icon(name, 47), False, False, 0)
            caption = styled(Gtk.Label(label=title), "desktop-label")
            caption.set_max_width_chars(13)
            tile.pack_start(caption, False, False, 0)
            control = button(tile, lambda c=command: spawn(c), "desktop-tile", tip=title)
            control.set_size_request(88, 91)
            col.pack_start(control, False, False, 0)
        self.desktop.add(col)

    def create_clock(self):
        self.clock_win = layer_window(
            GtkLayerShell.Layer.TOP,
            [GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.RIGHT], 19
        )
        clock_box = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1), "clock")
        self.time_label = styled(Gtk.Label(), "clock-time")
        self.date_label = styled(Gtk.Label(), "clock-date")
        clock_box.pack_start(self.time_label, False, False, 0)
        clock_box.pack_start(self.date_label, False, False, 0)
        self.clock_win.add(clock_box)

    def create_notch(self):
        self.notch_pinned = False
        self.notch_collapse_id = 0
        self.notch_win = layer_window(GtkLayerShell.Layer.TOP, [GtkLayerShell.Edge.TOP])
        eb = Gtk.EventBox()
        # Gtk.Revealer keeps the child's full WIDTH during a vertical slide.
        # A non-homogeneous Gtk.Stack gives the collapsed notch its own
        # true compact geometry instead of a 320px empty black rectangle.
        self.notch_stack = Gtk.Stack()
        self.notch_stack.set_hhomogeneous(False)
        self.notch_stack.set_vhomogeneous(False)
        self.notch_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.notch_stack.set_transition_duration(220)
        cap = styled(Gtk.Box(), "notch")
        cap.set_size_request(132, 23)
        self.notch_stack.add_named(cap, "closed")

        panel = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0), "notch")
        self.reveal = Gtk.Revealer()
        self.reveal.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.reveal.set_transition_duration(340)
        body = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8), "notch-content")
        heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        header_text.pack_start(styled(Gtk.Label(label="OneBook Hub", xalign=0), "notch-title"), False, False, 0)
        header_text.pack_start(styled(Gtk.Label(label="System controls", xalign=0), "notch-subtitle"), False, False, 0)
        heading.pack_start(header_text, True, True, 0)
        heading.pack_end(icon("onebook", 32), False, False, 0)
        body.pack_start(heading, False, False, 0)
        body.pack_start(styled(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), "notch-divider"), False, False, 0)
        self.net_label = styled(Gtk.Label(label="Network: checking", xalign=0), "notch-subtitle")
        body.pack_start(self.net_label, False, False, 0)
        action_row = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7), "notch-row")
        action_row.pack_start(button(Gtk.Label(label="Wi-Fi settings"), lambda: spawn(["nm-connection-editor"]), "notch-chip"), True, True, 0)
        action_row.pack_start(button(Gtk.Label(label="Display"), lambda: spawn(["foot", "-e", "onebook-display", "--list"]), "notch-chip"), True, True, 0)
        body.pack_start(action_row, False, False, 0)
        body.pack_start(styled(Gtk.Label(label="Volume", xalign=0), "notch-label"), False, False, 0)
        self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume.set_draw_value(False)
        self.volume.set_size_request(290, -1)
        self.volume.connect("value-changed", self.set_volume)
        body.pack_start(self.volume, False, False, 0)
        body.pack_start(styled(Gtk.Label(label="Brightness", xalign=0), "notch-label"), False, False, 0)
        self.brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
        self.brightness.set_draw_value(False)
        self.brightness.connect("value-changed", self.set_brightness)
        body.pack_start(self.brightness, False, False, 0)
        self.reveal.add(body)
        panel.pack_start(self.reveal, False, False, 0)
        self.notch_stack.add_named(panel, "expanded")
        self.notch_stack.set_visible_child_name("closed")
        eb.add(self.notch_stack)
        eb.connect("enter-notify-event", self.open_notch)
        eb.connect("leave-notify-event", self.schedule_notch_close)
        eb.connect("button-press-event", self.toggle_notch_pin)
        self.notch_win.add(eb)

    def toggle_notch_pin(self, *_args):
        self.notch_pinned = not self.notch_pinned
        if self.notch_pinned:
            self.open_notch()
        else:
            self.schedule_notch_close()
        return True

    def create_menu(self):
        self.menu_hide_id = 0
        self.menu_win = layer_window(
            GtkLayerShell.Layer.OVERLAY,
            [GtkLayerShell.Edge.BOTTOM], 94, keyboard=True
        )
        self.menu_reveal = Gtk.Revealer()
        self.menu_reveal.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.menu_reveal.set_transition_duration(270)
        menu = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14), "menu")
        menu.set_size_request(520, 525)
        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        title_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        title_text.pack_start(styled(Gtk.Label(label="OneBookOS", xalign=0), "menu-title"), False, False, 0)
        title_text.pack_start(styled(Gtk.Label(label="Everything you need, in one place", xalign=0), "menu-subtitle"), False, False, 0)
        title_row.pack_start(title_text, True, True, 0)
        title_row.pack_end(icon("onebook", 47), False, False, 0)
        menu.pack_start(title_row, False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search apps")
        self.search.connect("search-changed", lambda *_: self.fill_apps())
        menu.pack_start(self.search, False, False, 0)
        menu.pack_start(styled(Gtk.Label(label="Favorites", xalign=0), "menu-section"), False, False, 0)
        favorites = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        for name, label, command in [
            ("files", "Files", ["thunar"]),
            ("terminal", "Terminal", ["foot"]),
            ("notes", "Notes", ["mousepad"]),
            ("settings", "Settings", ["nm-connection-editor"]),
        ]:
            tile = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7), "quick-tile")
            tile.pack_start(icon(name, 38), False, False, 0)
            tile.pack_start(styled(Gtk.Label(label=label), "quick-label"), False, False, 0)
            control = button(tile, lambda c=command: self.launch_command(c), "app-tile", label)
            favorites.pack_start(control, True, True, 0)
        menu.pack_start(favorites, False, False, 0)
        menu.pack_start(styled(Gtk.Label(label="All applications", xalign=0), "menu-section"), False, False, 0)
        scroller = Gtk.ScrolledWindow()
        scroller.set_size_request(-1, 182)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.app_flow = Gtk.FlowBox()
        self.app_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.app_flow.set_min_children_per_line(4)
        self.app_flow.set_max_children_per_line(4)
        self.app_flow.set_row_spacing(4)
        self.app_flow.set_column_spacing(4)
        scroller.add(self.app_flow)
        menu.pack_start(scroller, True, True, 0)
        menu.pack_start(styled(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), "menu-divider"), False, False, 0)
        footer = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9), "menu-footer")
        footer.pack_start(styled(Gtk.Label(label="OneBookOS 0.3  ·  Preview", xalign=0), "menu-subtitle"), True, True, 0)
        footer.pack_end(button(Gtk.Label(label="Power"), lambda: spawn(["systemctl", "poweroff"])), False, False, 0)
        footer.pack_end(button(Gtk.Label(label="Log out"), lambda: spawn(["loginctl", "terminate-user", os.environ.get("USER", "obos")])), False, False, 0)
        menu.pack_start(footer, False, False, 0)
        self.menu_reveal.add(menu)
        self.menu_win.add(self.menu_reveal)
        self.apps = sorted(
            [app for app in Gio.AppInfo.get_all() if app.should_show()],
            key=lambda app: app.get_display_name().casefold()
        )
        self.fill_apps()

    def launch_command(self, command):
        spawn(command)
        self.toggle_menu()

    def fill_apps(self):
        for item in self.app_flow.get_children():
            self.app_flow.remove(item)
        query = self.search.get_text().strip().casefold()
        for app in [a for a in self.apps if query in a.get_display_name().casefold()][:40]:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            gicon = app.get_icon()
            if gicon:
                img = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.DIALOG)
                img.set_pixel_size(32)
            else:
                img = icon("onebook", 32)
            tile.pack_start(img, False, False, 0)
            label = styled(Gtk.Label(label=app.get_display_name()), "app-name")
            label.set_line_wrap(True)
            label.set_max_width_chars(11)
            label.set_ellipsize(3)
            tile.pack_start(label, False, False, 0)
            control = button(tile, lambda a=app: self.launch_app(a), "app-tile", app.get_display_name())
            control.set_size_request(102, 78)
            self.app_flow.add(control)
        self.app_flow.show_all()

    def launch_app(self, app):
        try:
            app.launch([], None)
        except GLib.Error as exc:
            print("Cannot launch", app.get_display_name(), str(exc), flush=True)
        self.toggle_menu()

    def toggle_menu(self):
        self.menu_visible = not self.menu_visible
        if self.menu_hide_id:
            GLib.source_remove(self.menu_hide_id)
            self.menu_hide_id = 0
        if self.menu_visible:
            self.search.set_text("")
            self.menu_reveal.set_reveal_child(False)
            self.menu_win.show_all()
            self.menu_reveal.set_reveal_child(True)
            self.search.grab_focus()
        else:
            self.menu_reveal.set_reveal_child(False)
            self.menu_hide_id = GLib.timeout_add(290, self.finish_menu_close)

    def finish_menu_close(self):
        self.menu_hide_id = 0
        if not self.menu_visible:
            self.menu_win.hide()
        return False

    def open_notch(self, *_args):
        if self.notch_close_id:
            GLib.source_remove(self.notch_close_id)
            self.notch_close_id = 0
        if self.notch_collapse_id:
            GLib.source_remove(self.notch_collapse_id)
            self.notch_collapse_id = 0
        self.notch_stack.set_visible_child_name("expanded")
        self.reveal.set_reveal_child(True)
        return False

    def schedule_notch_close(self, *_args):
        if self.notch_pinned:
            return False
        if self.notch_close_id:
            GLib.source_remove(self.notch_close_id)
        self.notch_close_id = GLib.timeout_add(520, self.close_notch)
        return False

    def close_notch(self):
        self.notch_close_id = 0
        if not self.notch_pinned:
            self.reveal.set_reveal_child(False)
            self.notch_collapse_id = GLib.timeout_add(355, self.finish_notch_collapse)
        return False

    def finish_notch_collapse(self):
        self.notch_collapse_id = 0
        if not self.notch_pinned and not self.reveal.get_reveal_child():
            self.notch_stack.set_visible_child_name("closed")
        return False

    def set_volume(self, widget):
        if not self.volume_updating:
            spawn(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(widget.get_value() / 100)])

    def set_brightness(self, widget):
        if not self.volume_updating:
            spawn(["brightnessctl", "set", str(round(widget.get_value())) + "%"])

    def tick(self):
        self.time_label.set_text(time.strftime("%H:%M"))
        self.date_label.set_text(time.strftime("%d.%m.%Y"))
        state = read_cmd(["nmcli", "-t", "-f", "STATE", "general"])
        self.net_label.set_text("Network: " + (state or "unavailable"))
        vol = read_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        match = re.search(r"(\d+\.\d+)", vol)
        self.volume_updating = True
        if match:
            self.volume.set_value(min(100, float(match.group(1)) * 100))
        raw = read_cmd(["brightnessctl", "-m"])
        match = re.search(r"(\d+)%", raw)
        if match:
            self.brightness.set_value(int(match.group(1)))
            self.brightness.set_sensitive(True)
        else:
            self.brightness.set_sensitive(False)
        self.volume_updating = False
        return True

    def preview_menu_for_qa(self):
        if not self.menu_visible:
            self.menu_visible = True
            self.menu_win.show_all()
            self.menu_reveal.set_reveal_child(True)
        return False

    def mark_ready(self):
        path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "onebook-shell-ready"
        path.write_text("shell GTK layer surfaces initialized\n", encoding="utf-8")
        return False

if __name__ == "__main__":
    Desktop()
    Gtk.main()
