.quick-label { color: #eef3ff; font-size: 12px; font-weight: 600; }
.menu-footer button { background: rgba(255,255,255,.09); border: 0; border-radius: 12px; padding: 9px 15px; color: #f7f9ff; }
.menu-footer button:hover { background: rgba(255,255,255,.17); }
