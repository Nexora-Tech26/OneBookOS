#!/usr/bin/python3
"""OneBookUI native Wayland layer-shell preview (not a GNOME extension)."""
import json
import os
import re
import subprocess
import time
from pathlib import Path
import sys
sys.path.insert(0, "/usr/local/lib/onebookos")
from layout import compute_layout
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gio, GLib, Gdk, GdkPixbuf, GtkLayerShell

ICON_DIR = Path("/usr/share/onebookos/icons")
THEME_CSS = Path("/usr/share/onebookos/design/shell.css")


def styled(widget, cls):
    widget.get_style_context().add_class(cls)
    return widget

def spawn(argv):
    try:
        subprocess.Popen(argv, start_new_session=True)
    except OSError as exc:
        print("OneBookUI launch error:", exc, flush=True)

def read_cmd(argv):
    try:
        return subprocess.check_output(argv, text=True, stderr=subprocess.DEVNULL, timeout=2).strip()
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return ""

def icon(name, size=24):
    # Rasterize the source SVG at the requested size; avoid upscaling 64px pixmaps.
    path = ICON_DIR / (name + ".svg")
    if path.is_file():
        try:
            picture = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), size, size, True)
            return Gtk.Image.new_from_pixbuf(picture)
        except GLib.Error as exc:
            print("OneBookUI icon failed:", path, exc, flush=True)
    return Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.BUTTON)

def layer_window(layer, edges, margin=0, keyboard=False):
    w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    w.set_decorated(False)
    w.set_resizable(False)
    w.set_app_paintable(True)
    rgba = w.get_screen().get_rgba_visual()
    if rgba is not None:
        w.set_visual(rgba)
    GtkLayerShell.init_for_window(w)
    GtkLayerShell.set_layer(w, layer)
    for edge in edges:
        GtkLayerShell.set_anchor(w, edge, True)
        GtkLayerShell.set_margin(w, edge, margin)
    if keyboard:
        GtkLayerShell.set_keyboard_mode(w, GtkLayerShell.KeyboardMode.ON_DEMAND)
    return w

def button(child, callback, cls="launcher", tip=None):
    b = styled(Gtk.Button(), cls)
    b.add(child)
    b.connect("clicked", lambda _b: callback())
    if tip:
        b.set_tooltip_text(tip)
    return b

class Desktop:
    def __init__(self):
        css = Gtk.CssProvider()
        css.load_from_path(str(THEME_CSS))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self.ready = False
        self.volume_updating = False
        self.menu_visible = False
        self.notch_close_id = 0
        self.create_dock()
        self.create_desktop_shortcuts()
        self.create_clock()
        self.create_notch()
        self.create_menu()
        self.start_win.show_all()
        self.left_dock.show_all()
        self.right_dock.show_all()
        self.desktop.show_all()
        self.clock_win.show_all()
        self.notch_win.show_all()
        self.menu_win.hide()
        self.refresh_layout(force=True)
        GLib.timeout_add_seconds(2, self.refresh_layout)
        GLib.timeout_add_seconds(1, self.tick)
        GLib.timeout_add(2000, self.mark_ready)
        # During QEMU screenshot QA, display the real launcher for visual inspection.
        cmdline = Path("/proc/cmdline").read_text(encoding="utf-8")
        if "obos.notch-test=1" in cmdline:
            GLib.timeout_add(3500, self.preview_notch_for_qa)
        elif "obos.gui-test=1" in cmdline:
            GLib.timeout_add(5000, self.preview_menu_for_qa)

    def monitor_width(self):
        """Wayland monitor geometry uses logical pixels, not raw panel pixels."""
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor()
        if monitor is None and display.get_n_monitors():
            monitor = display.get_monitor(0)
        self.active_monitor = monitor
        if monitor is not None:
            return max(320, int(monitor.get_geometry().width))
        return max(320, Gdk.Screen.get_default().get_width())

    def place_on_active_monitor(self, window):
        if self.active_monitor is not None and hasattr(GtkLayerShell, "set_monitor"):
            GtkLayerShell.set_monitor(window, self.active_monitor)

    def create_dock(self):
        """Separate Wayland layer surfaces: left bar, exact-center Start, right bar.

        The clock stays independently anchored to bottom-right so it does not
        move when the number of running application buttons changes.
        """
        self.monitor_width()
        self.left_dock = layer_window(
            GtkLayerShell.Layer.TOP, [GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT], 18
        )
        self.right_dock = layer_window(
            GtkLayerShell.Layer.TOP, [GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT], 18
        )
        self.start_win = layer_window(GtkLayerShell.Layer.TOP, [GtkLayerShell.Edge.BOTTOM], 18)
        for window in (self.left_dock, self.right_dock, self.start_win):
            self.place_on_active_monitor(window)
            GtkLayerShell.set_exclusive_zone(window, 0)

        left = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5), "dock-shell")
        right = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5), "dock-shell")
        self.left_buttons = []
        self.right_buttons = []
        for name, label, command in (
            ("files", "Files", ["thunar"]),
            ("terminal", "Terminal", ["foot"]),
        ):
            control = button(icon(name, 30), lambda c=command: spawn(c), tip=label)
            control.set_size_request(52, 52)
            left.pack_start(control, False, False, 0)
            self.left_buttons.append(control)
        for name, label, command in (
            ("settings", "Settings", ["xfce4-settings-manager"]),
            ("monitor", "System monitor", ["foot", "-e", "top"]),
        ):
            control = button(icon(name, 30), lambda c=command: spawn(c), tip=label)
            control.set_size_request(52, 52)
            right.pack_start(control, False, False, 0)
            self.right_buttons.append(control)

        self.start_btn = button(icon("onebook", 36), self.toggle_menu, "start", "Start")
        self.start_btn.set_size_request(62, 62)
        self.start_btn.set_hexpand(True)
        self.start_btn.set_vexpand(True)
        start = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL), "start-shell")
        start.pack_start(self.start_btn, True, True, 0)
        self.left_dock.add(left)
        self.right_dock.add(right)
        self.start_win.add(start)
        self.current_layout = None

    def refresh_layout(self, force=False):
        """Recalculate independent surface placement after resolution changes."""
        width = self.monitor_width()
        positions = compute_layout(width)
        if force or self.current_layout != positions:
            self.current_layout = positions
            for window in (self.left_dock, self.right_dock, self.start_win, self.clock_win,
                           self.notch_win, self.menu_win):
                self.place_on_active_monitor(window)
            for window in (self.left_dock, self.right_dock, self.start_win, self.clock_win):
                GtkLayerShell.set_margin(window, GtkLayerShell.Edge.BOTTOM, positions["bottom_margin"])
            GtkLayerShell.set_margin(self.left_dock, GtkLayerShell.Edge.LEFT, positions["left_x"])
            GtkLayerShell.set_margin(self.right_dock, GtkLayerShell.Edge.LEFT, positions["right_x"])
            GtkLayerShell.set_margin(self.clock_win, GtkLayerShell.Edge.RIGHT, positions["clock_margin"])
            self.start_win.set_size_request(positions["start_width"], 72)
            self.left_dock.set_size_request(positions["segment_width"], 70)
            self.right_dock.set_size_request(positions["segment_width"], 70)
            self.clock_win.set_size_request(positions["clock_width"], 70)
            self.left_buttons[1].set_visible(positions["show_second_icon"])
            self.right_buttons[1].set_visible(positions["show_second_icon"])
            self.left_dock.set_visible(positions["show_left"])
            self.right_dock.set_visible(positions["show_right"])
            GtkLayerShell.set_margin(
                self.menu_win, GtkLayerShell.Edge.BOTTOM, positions["bottom_margin"] + 84
            )
        return True

    def create_desktop_shortcuts(self):
        self.desktop = layer_window(
            GtkLayerShell.Layer.BOTTOM,
            [GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT], 27
        )
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        for name, title, command in [
            ("files", "Files", ["thunar"]),
            ("terminal", "Terminal", ["foot"]),
            ("settings", "Settings", ["xfce4-settings-manager"]),
            ("monitor", "Task Manager", ["xfce4-taskmanager"]),
        ]:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            tile.pack_start(icon(name, 54), False, False, 0)
            caption = styled(Gtk.Label(label=title), "desktop-label")
            caption.set_max_width_chars(13)
            tile.pack_start(caption, False, False, 0)
            control = button(tile, lambda c=command: spawn(c), "desktop-tile", tip=title)
            control.set_size_request(96, 102)
            col.pack_start(control, False, False, 0)
        self.desktop.add(col)

    def create_clock(self):
        self.clock_win = layer_window(
            GtkLayerShell.Layer.TOP,
            [GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.RIGHT], 19
        )
        clock_box = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1), "clock")
        self.time_label = styled(Gtk.Label(), "clock-time")
        self.date_label = styled(Gtk.Label(), "clock-date")
        clock_box.pack_start(self.time_label, False, False, 0)
        clock_box.pack_start(self.date_label, False, False, 0)
        self.clock_win.add(clock_box)
        GtkLayerShell.set_exclusive_zone(self.clock_win, 0)

    def hub_line(self, parent, text="Checking...", style="notch-subtitle"):
        label = styled(Gtk.Label(label=text, xalign=0), style)
        label.set_line_wrap(True)
        label.set_max_width_chars(57)
        parent.pack_start(label, False, False, 0)
        return label

    def hub_action(self, parent, name, command=None, callback=None):
        if callback is None:
            callback = lambda c=command: spawn(c)
        control = button(Gtk.Label(label=name), callback, "notch-chip")
        parent.pack_start(control, False, False, 0)
        return control

    def hub_row(self, parent):
        row = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8), "notch-row")
        parent.pack_start(row, False, False, 0)
        return row

    def hub_section(self, title, hint):
        box = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10), "notch-page")
        self.hub_line(box, title, "notch-section-title")
        self.hub_line(box, hint, "notch-subtitle")
        return box

    def create_notch(self):
        """One integrated, top-centered 6-page system hub; no fake toggles."""
        self.notch_pinned = False
        self.notch_collapse_id = 0
        self.notch_win = layer_window(GtkLayerShell.Layer.TOP, [GtkLayerShell.Edge.TOP])
        self.place_on_active_monitor(self.notch_win)
        GtkLayerShell.set_exclusive_zone(self.notch_win, 0)

        event_box = Gtk.EventBox()
        self.notch_stack = Gtk.Stack()
        self.notch_stack.set_hhomogeneous(False)
        self.notch_stack.set_vhomogeneous(False)
        self.notch_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.notch_stack.set_transition_duration(200)

        closed = styled(Gtk.Box(), "notch")
        closed.set_size_request(112, 22)
        self.notch_stack.add_named(closed, "closed")
        expanded = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL), "notch")
        self.reveal = Gtk.Revealer()
        self.reveal.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
        self.reveal.set_transition_duration(280)
        body = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10), "notch-content")
        body.set_size_request(min(410, max(270, self.monitor_width() - 46)), -1)
        head = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10), "notch-heading")
        self.hub_line(head, "OneBook Hub", "notch-title")
        self.hub_pin = self.hub_action(head, "Pin", callback=self.toggle_notch_pin)
        self.hub_settings = self.hub_action(
            head, "Settings", command=["xfce4-settings-manager"]
        )
        body.pack_start(head, False, False, 0)

        self.hub_pages = Gtk.Stack()
        self.hub_pages.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.hub_pages.set_transition_duration(170)
        self.hub_pages.set_hhomogeneous(True)
        self.hub_pages.set_vhomogeneous(False)
        self.hub_pages.connect("notify::visible-child-name", self.hub_page_changed)
        # Fixed 6-way tab grid prevents Gtk.StackSwitcher natural width from
        # stretching the hub into an oversized banner on a desktop.
        self.hub_tabs = {}
        tabs = styled(Gtk.Grid(column_spacing=3, row_spacing=3), "notch-tabs")
        for position, (page_id, label) in enumerate([
            ("status", "Status"), ("media", "Media"), ("controls", "Sound"),
            ("connections", "Wi-Fi"), ("devices", "Devices"),
            ("notifications", "Alerts"),
        ]):
            control = styled(Gtk.ToggleButton(label=label), "hub-tab")
            control.set_size_request(52, 30)
            control.set_hexpand(True)
            control.connect(
                "clicked",
                lambda _widget, target=page_id: self.hub_pages.set_visible_child_name(target)
            )
            columns = 6 if self.monitor_width() >= 660 else 3
            tabs.attach(control, position % columns, position // columns, 1, 1)
            self.hub_tabs[page_id] = control
        body.pack_start(tabs, False, False, 0)

        # Status: use live network, power-supply and system resource information.
        status = self.hub_section("System status", "Live device information")
        self.status_network = self.hub_line(status)
        self.status_battery = self.hub_line(status)
        self.status_memory = self.hub_line(status)
        self.hub_pages.add_titled(status, "status", "Status")

        media = self.hub_section("Media", "MPRIS-compatible player controls")
        self.media_status = self.hub_line(media, "No compatible player detected")
        media_row = self.hub_row(media)
        self.hub_action(media_row, "Previous", command=["playerctl", "previous"])
        self.hub_action(media_row, "Play / pause", command=["playerctl", "play-pause"])
        self.hub_action(media_row, "Next", command=["playerctl", "next"])
        self.hub_action(self.hub_row(media), "Sound mixer", command=["pavucontrol"])
        self.hub_pages.add_titled(media, "media", "Media")

        controls = self.hub_section("System controls", "Connected to PipeWire and backlight devices")
        self.hub_line(controls, "Volume", "notch-label")
        self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume.set_draw_value(False)
        self.volume.set_size_request(225, -1)
        self.volume.connect("value-changed", self.set_volume)
        controls.pack_start(self.volume, False, False, 0)
        self.hub_line(controls, "Brightness", "notch-label")
        self.brightness = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 100, 1)
        self.brightness.set_draw_value(False)
        self.brightness.connect("value-changed", self.set_brightness)
        controls.pack_start(self.brightness, False, False, 0)
        controls_row = self.hub_row(controls)
        self.mute_button = self.hub_action(controls_row, "Mute / unmute",
                                           command=["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
        self.hub_action(controls_row, "Sound settings", command=["pavucontrol"])
        self.hub_pages.add_titled(controls, "controls", "Controls")

        connections = self.hub_section("Connections", "NetworkManager and BlueZ controls")
        self.wifi_status = self.hub_line(connections)
        self.wifi_toggle = self.hub_action(
            self.hub_row(connections), "Wi-Fi", callback=self.toggle_wifi
        )
        self.bt_status = self.hub_line(connections)
        self.bt_toggle = self.hub_action(
            self.hub_row(connections), "Bluetooth", callback=self.toggle_bluetooth
        )
        network_row = self.hub_row(connections)
        self.hub_action(network_row, "Network", command=["nm-connection-editor"])
        self.hub_action(network_row, "Bluetooth devices", command=["blueman-manager"])
        self.hub_pages.add_titled(connections, "connections", "Network")

        devices = self.hub_section("Devices", "Attached hardware and local storage")
        self.device_battery = self.hub_line(devices)
        self.device_storage = self.hub_line(devices)
        self.device_monitor = self.hub_line(devices)
        device_row = self.hub_row(devices)
        self.hub_action(device_row, "Task manager", command=["xfce4-taskmanager"])
        self.hub_action(device_row, "Display details", command=["foot", "-e", "onebook-display", "--list"])
        self.hub_pages.add_titled(devices, "devices", "Devices")

        notifications = self.hub_section("Notifications", "Active notifications from Mako")
        self.notification_status = self.hub_line(notifications, "No active notifications")
        alert_row = self.hub_row(notifications)
        self.hub_action(alert_row, "Test notification",
                        command=["notify-send", "OneBookOS", "OneBook Hub notifications work"])
        self.hub_action(alert_row, "Clear all", callback=self.dismiss_notifications)
        self.hub_pages.add_titled(notifications, "notifications", "Alerts")
        self.hub_page_changed()

        body.pack_start(self.hub_pages, False, False, 0)
        self.reveal.add(body)
        expanded.pack_start(self.reveal, False, False, 0)
        self.notch_stack.add_named(expanded, "expanded")
        self.notch_stack.set_visible_child_name("closed")
        event_box.add(self.notch_stack)
        event_box.connect("enter-notify-event", self.open_notch)
        event_box.connect("leave-notify-event", self.schedule_notch_close)
        self.notch_win.add(event_box)
        GLib.timeout_add_seconds(5, self.refresh_notch_info)

    def hub_page_changed(self, *_args):
        current = self.hub_pages.get_visible_child_name()
        for name, tab in self.hub_tabs.items():
            if tab.get_active() != (name == current):
                tab.set_active(name == current)
        GLib.idle_add(self.refresh_notch_info)

    def toggle_notch_pin(self, *_args):
        self.notch_pinned = not self.notch_pinned
        self.hub_pin.get_child().set_text("Unpin" if self.notch_pinned else "Pin")
        if self.notch_pinned:
            self.open_notch()
        else:
            self.schedule_notch_close()
        return True

    def toggle_wifi(self):
        current = read_cmd(["nmcli", "radio", "wifi"]).lower()
        if current in ("enabled", "disabled"):
            spawn(["nmcli", "radio", "wifi", "off" if current == "enabled" else "on"])
            GLib.timeout_add(1500, self.refresh_after_action)

    def toggle_bluetooth(self):
        show = read_cmd(["bluetoothctl", "show"])
        if "Powered: yes" in show or "Powered: no" in show:
            new_value = "off" if "Powered: yes" in show else "on"
            spawn(["bluetoothctl", "power", new_value])
            GLib.timeout_add(1500, self.refresh_after_action)

    def refresh_after_action(self):
        self.refresh_notch_info()
        return False

    def dismiss_notifications(self):
        spawn(["makoctl", "dismiss", "-a"])
        GLib.timeout_add(500, self.refresh_after_action)

    def battery_description(self):
        supplies = Path("/sys/class/power_supply")
        try:
            for item in sorted(supplies.glob("BAT*")):
                capacity = (item / "capacity").read_text().strip()
                status = (item / "status").read_text().strip()
                return f"{capacity}% ({status.lower()})"
        except (OSError, ValueError):
            pass
        return "not available (desktop/VM or unsupported)"

    def refresh_notch_info(self):
        if self.notch_stack.get_visible_child_name() != "expanded":
            return True
        page = self.hub_pages.get_visible_child_name()
        if page == "status":
            network = read_cmd(["nmcli", "-t", "-f", "STATE", "general"])
            self.status_network.set_text("Network: " + (network or "unavailable"))
            self.status_battery.set_text("Battery: " + self.battery_description())
            try:
                pages = os.sysconf("SC_PHYS_PAGES")
                size = os.sysconf("SC_PAGE_SIZE")
                self.status_memory.set_text(f"Installed RAM: {pages * size / (1024 ** 3):.1f} GiB")
            except (OSError, ValueError):
                self.status_memory.set_text("Memory: unavailable")
        elif page == "media":
            metadata = read_cmd(["playerctl", "metadata", "--format",
                                 "{{playerName}} — {{artist}} / {{title}}"])
            self.media_status.set_text(metadata[:180] if metadata else "No active MPRIS player")
        elif page == "controls":
            vol = read_cmd(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
            match = re.search(r"(\d+\.\d+)", vol)
            self.volume_updating = True
            if match:
                self.volume.set_value(min(100, float(match.group(1)) * 100))
                self.volume.set_sensitive(True)
            else:
                self.volume.set_sensitive(False)
            current = read_cmd(["brightnessctl", "-m"])
            brightness = re.search(r"(\d+)%", current)
            if brightness:
                self.brightness.set_value(int(brightness.group(1)))
                self.brightness.set_sensitive(True)
            else:
                self.brightness.set_sensitive(False)
            self.volume_updating = False
            self.mute_button.get_child().set_text(
                "Unmute" if "[MUTED]" in vol else "Mute"
            )
            self.mute_button.set_sensitive(bool(match))
        elif page == "connections":
            wifi = read_cmd(["nmcli", "radio", "wifi"]).lower()
            self.wifi_status.set_text("Wi-Fi: " + (wifi or "unavailable"))
            self.wifi_toggle.get_child().set_text("Disable Wi-Fi" if wifi == "enabled" else "Enable Wi-Fi")
            self.wifi_toggle.set_sensitive(wifi in ("enabled", "disabled"))
            bt = read_cmd(["bluetoothctl", "show"])
            available = "Powered: yes" in bt or "Powered: no" in bt
            self.bt_status.set_text("Bluetooth: " +
                ("on" if "Powered: yes" in bt else "off" if available else "no adapter found"))
            self.bt_toggle.get_child().set_text("Turn Bluetooth off" if "Powered: yes" in bt else "Turn Bluetooth on")
            self.bt_toggle.set_sensitive(available)
        elif page == "devices":
            self.device_battery.set_text("Battery: " + self.battery_description())
            try:
                import shutil
                usage = shutil.disk_usage("/")
                self.device_storage.set_text(
                    f"Storage (live root): {usage.used / (1024 ** 3):.1f} / "
                    f"{usage.total / (1024 ** 3):.1f} GiB used"
                )
            except OSError:
                self.device_storage.set_text("Storage: unavailable")
            self.device_monitor.set_text("Display: " + str(self.monitor_width()) + " logical px wide")
        elif page == "notifications":
            lines = read_cmd(["makoctl", "list"]).strip()
            self.notification_status.set_text(
                lines[:420] if lines else "No active notifications (or Mako unavailable)"
            )
        return True

    def preview_notch_for_qa(self):
        """Expose the real expanded controls surface to graphical QEMU tests."""
        self.notch_pinned = True
        self.hub_pin.get_child().set_text("Unpin")
        self.hub_pages.set_visible_child_name("controls")
        self.open_notch()
        self.refresh_notch_info()
        # Screenshot must wait until the revealer has completed its transition.
        GLib.timeout_add(800, self.mark_notch_test_ready)
        return False

    def mark_notch_test_ready(self):
        path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "onebook-notch-ready"
        path.write_text("expanded controls rendered\n", encoding="utf-8")
        return False

    def create_menu(self):
        self.menu_hide_id = 0
        self.menu_win = layer_window(
            GtkLayerShell.Layer.OVERLAY,
            [GtkLayerShell.Edge.BOTTOM], 94, keyboard=True
        )
        self.menu_reveal = Gtk.Revealer()
        self.menu_reveal.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.menu_reveal.set_transition_duration(270)
        menu = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14), "menu")
        screen = Gdk.Display.get_default().get_primary_monitor()
        if screen is None:
            screen = Gdk.Display.get_default().get_monitor(0)
        area = screen.get_geometry()
        menu.set_size_request(min(540, max(360, area.width - 64)), min(520, max(360, area.height - 145)))
        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        title_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        title_text.pack_start(styled(Gtk.Label(label="OneBookOS", xalign=0), "menu-title"), False, False, 0)
        title_text.pack_start(styled(Gtk.Label(label="Everything you need, in one place", xalign=0), "menu-subtitle"), False, False, 0)
        title_row.pack_start(title_text, True, True, 0)
        title_row.pack_end(icon("onebook", 47), False, False, 0)
        menu.pack_start(title_row, False, False, 0)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search apps")
        self.search.connect("search-changed", lambda *_: self.fill_apps())
        menu.pack_start(self.search, False, False, 0)
        menu.pack_start(styled(Gtk.Label(label="Favorites", xalign=0), "menu-section"), False, False, 0)
        favorites = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        for name, label, command in [
            ("files", "Files", ["thunar"]),
            ("terminal", "Terminal", ["foot"]),
            ("notes", "Notes", ["mousepad"]),
            ("settings", "Settings", ["xfce4-settings-manager"]),
        ]:
            tile = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7), "quick-tile")
            tile.pack_start(icon(name, 38), False, False, 0)
            tile.pack_start(styled(Gtk.Label(label=label), "quick-label"), False, False, 0)
            control = button(tile, lambda c=command: self.launch_command(c), "app-tile", label)
            favorites.pack_start(control, True, True, 0)
        menu.pack_start(favorites, False, False, 0)
        menu.pack_start(styled(Gtk.Label(label="All applications", xalign=0), "menu-section"), False, False, 0)
        scroller = Gtk.ScrolledWindow()
        scroller.set_size_request(-1, 158)
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.app_flow = Gtk.FlowBox()
        self.app_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.app_flow.set_min_children_per_line(4)
        self.app_flow.set_max_children_per_line(4)
        self.app_flow.set_row_spacing(4)
        self.app_flow.set_column_spacing(4)
        scroller.add(self.app_flow)
        menu.pack_start(scroller, True, True, 0)
        menu.pack_start(styled(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), "menu-divider"), False, False, 0)
        footer = styled(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9), "menu-footer")
        footer.pack_start(styled(Gtk.Label(label="OneBookOS · Developer Preview", xalign=0), "menu-subtitle"), True, True, 0)
        footer.pack_end(button(Gtk.Label(label="Power"), lambda: spawn(["systemctl", "poweroff"])), False, False, 0)
        footer.pack_end(button(Gtk.Label(label="Log out"), lambda: spawn(["loginctl", "terminate-user", os.environ.get("USER", "obos")])), False, False, 0)
        menu.pack_start(footer, False, False, 0)
        self.menu_reveal.add(menu)
        self.menu_win.add(self.menu_reveal)
        self.apps = sorted(
            [app for app in Gio.AppInfo.get_all() if app.should_show()],
            key=lambda app: app.get_display_name().casefold()
        )
        self.fill_apps()

    def launch_command(self, command):
        spawn(command)
        self.toggle_menu()

    def fill_apps(self):
        for item in self.app_flow.get_children():
            self.app_flow.remove(item)
        query = self.search.get_text().strip().casefold()
        for app in [a for a in self.apps if query in a.get_display_name().casefold()][:40]:
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            gicon = app.get_icon()
            if gicon:
                img = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.DIALOG)
                img.set_pixel_size(36)
            else:
                img = icon("onebook", 36)
            tile.pack_start(img, False, False, 0)
            label = styled(Gtk.Label(label=app.get_display_name()), "app-name")
            label.set_line_wrap(True)
            label.set_max_width_chars(11)
            label.set_ellipsize(3)
            tile.pack_start(label, False, False, 0)
            control = button(tile, lambda a=app: self.launch_app(a), "app-tile", app.get_display_name())
            control.set_size_request(112, 88)
            self.app_flow.add(control)
        self.app_flow.show_all()

    def launch_app(self, app):
        try:
            app.launch([], None)
        except GLib.Error as exc:
            print("Cannot launch", app.get_display_name(), str(exc), flush=True)
        self.toggle_menu()

    def toggle_menu(self):
        self.menu_visible = not self.menu_visible
        if self.menu_hide_id:
            GLib.source_remove(self.menu_hide_id)
            self.menu_hide_id = 0
        if self.menu_visible:
            self.search.set_text("")
            self.menu_reveal.set_reveal_child(False)
            self.menu_win.show_all()
            self.menu_reveal.set_reveal_child(True)
            self.search.grab_focus()
        else:
            self.menu_reveal.set_reveal_child(False)
            self.menu_hide_id = GLib.timeout_add(290, self.finish_menu_close)

    def finish_menu_close(self):
        self.menu_hide_id = 0
        if not self.menu_visible:
            self.menu_win.hide()
        return False

    def open_notch(self, *_args):
        if self.notch_close_id:
            GLib.source_remove(self.notch_close_id)
            self.notch_close_id = 0
        if self.notch_collapse_id:
            GLib.source_remove(self.notch_collapse_id)
            self.notch_collapse_id = 0
        self.notch_stack.set_visible_child_name("expanded")
        self.reveal.set_reveal_child(True)
        return False

    def schedule_notch_close(self, *_args):
        if self.notch_pinned:
            return False
        if self.notch_close_id:
            GLib.source_remove(self.notch_close_id)
        self.notch_close_id = GLib.timeout_add(520, self.close_notch)
        return False

    def close_notch(self):
        self.notch_close_id = 0
        if not self.notch_pinned:
            self.reveal.set_reveal_child(False)
            self.notch_collapse_id = GLib.timeout_add(355, self.finish_notch_collapse)
        return False

    def finish_notch_collapse(self):
        self.notch_collapse_id = 0
        if not self.notch_pinned and not self.reveal.get_reveal_child():
            self.notch_stack.set_visible_child_name("closed")
        return False

    def set_volume(self, widget):
        if not self.volume_updating:
            spawn(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(widget.get_value() / 100)])

    def set_brightness(self, widget):
        if not self.volume_updating:
            spawn(["brightnessctl", "set", str(round(widget.get_value())) + "%"])

    def tick(self):
        self.time_label.set_text(time.strftime("%H:%M"))
        self.date_label.set_text(time.strftime("%d.%m.%Y"))
        return True

    def preview_menu_for_qa(self):
        if not self.menu_visible:
            self.menu_visible = True
            self.menu_win.show_all()
            self.menu_reveal.set_reveal_child(True)
        return False

    def mark_ready(self):
        path = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "onebook-shell-ready"
        path.write_text("shell GTK layer surfaces initialized\n", encoding="utf-8")
        info = dict(self.current_layout)
        info["surface_allocations"] = {
            "start": self.start_win.get_allocated_width(),
            "left": self.left_dock.get_allocated_width(),
            "right": self.right_dock.get_allocated_width(),
            "clock": self.clock_win.get_allocated_width(),
        }
        (path.parent / "onebook-layout.json").write_text(
            json.dumps(info, indent=2) + "\n", encoding="utf-8"
        )
        return False

if __name__ == "__main__":
    Desktop()
    Gtk.main()
