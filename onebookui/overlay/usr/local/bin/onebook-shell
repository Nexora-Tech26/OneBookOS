.notch-divider { background: rgba(255,255,255,.1); min-height: 1px; margin: 9px 0; }
.menu { background: rgba(24,31,49,.98); border: 1px solid rgba(250,252,255,.14); border-radius: 28px; padding: 24px; box-shadow: 0 8px 36px rgba(18,22,38,.26); }
.menu-title { color: #ffffff; font-size: 24px; font-weight: 800; }
