#!/usr/bin/env bash
set -Eeuo pipefail
# This is a VM smoke test, not an unattended login hack. Only inspect local X :0.
for attempt in $(seq 1 100); do
  if DISPLAY=:0 XAUTHORITY=/var/run/lightdm/root/:0 xset q >/dev/null 2>&1 || \
     DISPLAY=:0 xset q >/dev/null 2>&1; then
    if pgrep -u obos -f 'xfce4-session|startxfce4' >/dev/null 2>&1 && \
       pgrep -u obos -f '/usr/local/bin/obos-shell' >/dev/null 2>&1; then
      echo 'OBOS_GUI_OK' > /dev/ttyS0
      exit 0
    fi
  fi
  sleep 2
done
echo 'OBOS_GUI_FAILED: LightDM, XFCE and the OBOS shell did not all start' > /dev/ttyS0
systemctl --no-pager -l status lightdm.service >> /dev/ttyS0 2>&1 || true
journalctl -b -u lightdm --no-pager -n 45 >> /dev/ttyS0 2>&1 || true
exit 1
