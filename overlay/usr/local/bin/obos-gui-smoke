#!/usr/bin/env bash
set -Eeuo pipefail
# The marker is created by the GNOME Shell extension itself on successful enable().
# The desktop test therefore requires GDM, an actual user GNOME Shell and the extension.
for attempt in $(seq 1 150); do
  if pgrep -u obos -x gnome-shell >/dev/null 2>&1 && \
     pgrep -u obos -f gnome-session >/dev/null 2>&1 && \
     test -f /tmp/obos-gnome-extension-ready; then
    echo 'OBOS_GUI_OK' > /dev/ttyS0
    exit 0
  fi
  sleep 2
done
echo 'OBOS_GUI_FAILED: GNOME Shell, session or OneBook extension missing' > /dev/ttyS0
systemctl --no-pager -l status gdm3.service >> /dev/ttyS0 2>&1 || true
journalctl -b -u gdm3 --no-pager -n 60 >> /dev/ttyS0 2>&1 || true
journalctl -b --no-pager -n 40 | grep -Ei 'gnome-shell|onebookos|extension' >> /dev/ttyS0 2>&1 || true
exit 1
