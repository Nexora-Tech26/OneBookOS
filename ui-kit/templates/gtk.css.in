/* OneBookUI 8 original GTK3 app theme — generated by ui-kit/build.py. */
@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained.css");
window, dialog { color: {{app_text}}; background-color: {{app_surface}}; font-family: "Noto Sans"; font-size: {{app_body_font_px}}px; }
headerbar, .titlebar {
  background-image: linear-gradient(to bottom, #F7F8FF, {{app_header}});
  background-color: {{app_header}};
  color: {{app_text}}; border: 0; border-bottom: 1px solid {{border_light}};
  border-radius: 13px 13px 0 0; box-shadow: none; text-shadow: none;
  min-height: {{titlebar_height_px}}px; padding: 0 12px;
}
headerbar:backdrop, .titlebar:backdrop { background-image: none; background-color: #F1F4FA; color: {{app_muted}}; }
headerbar button, .titlebar button {
  background-image: none; background-color: transparent; border: 0;
  border-radius: 10px; box-shadow: none; text-shadow: none;
  padding: 3px 7px; min-height: {{window_control_px}}px; min-width: {{window_control_px}}px;
}
headerbar button:hover, .titlebar button:hover { background-color: {{accent_light}}; }
button {
  background-image: none; background-color: #ECF1FF; color: {{app_text}};
  border: 1px solid {{border_light}}; border-radius: {{corner_button_px}}px;
  box-shadow: none; text-shadow: none; min-height: {{app_control_height_px}}px; padding: 6px 12px;
}
button:hover { background-color: {{accent_light}}; background-image: none; box-shadow: none; }
button:active { background-color: #BAD0FF; background-image: none; box-shadow: none; }
button:disabled { background-color: #F2F3F9; color: #8D9BB1; }
entry, searchentry {
  background-color: #FFFFFF; color: {{app_text}}; border-radius: 12px;
  border: 1px solid {{border_light}}; box-shadow: none; min-height: 36px; padding: 7px 11px;
}
entry:focus, searchentry:focus { border-color: {{accent_blue}}; }
scrolledwindow, textview { border-radius: 12px; }
selection { background-color: {{accent_light}}; color: {{app_text}}; }
*:focus { outline-color: {{accent_blue}}; }

/* Stage 5 — readable GTK3 application controls on standard and HiDPI panels. */
notebook tab { min-height: 30px; padding: 6px 10px; }
treeview.view, treeview header button { font-size: {{app_body_font_px}}px; }
list row, row { min-height: 34px; padding: 4px; }
spinbutton button, combobox button { min-height: 34px; min-width: 34px; }
toolbar button { min-height: 34px; min-width: 34px; }
scrollbar slider { min-width: 8px; min-height: 8px; }
