/* OneBookUI 8: original desktop theme, generated from ui-kit/tokens.json.
   The visual UI remains a GTK3/Wayland preview, not a completed Samsung desktop. */
* { -GtkWidget-focus-padding: 0; -GtkWidget-focus-line-width: 0; }
window {
  background-color: transparent;
  color: {{text_on_dark}};
  font-family: "Noto Sans", sans-serif;
  font-size: 14px;
}
button { background-image: none; background-color: transparent; box-shadow: none; outline: none; text-shadow: none; border: 0; transition: background-color {{motion_fast_ms}}ms ease-out; }
button:focus { outline-color: {{accent_light}}; outline-style: solid; outline-width: 1px; }
.dock-shell {
  /* Independent left/right taskbar segments; transparent glass with soft shadow. */
  background-color: rgba(222, 217, 255, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.56);
  border-radius: 24px; padding: 6px 10px; min-height: 56px;
  box-shadow: 0 9px 28px rgba(34, 21, 112, 0.25), inset 0 1px rgba(255,255,255,0.35);
}
.dock-segment { background-color: transparent; padding: 0 4px; }
.start-shell { padding: 4px; border-radius: 23px; background-color: rgba(228,225,255,0.90); border: 1px solid rgba(255,255,255,0.62); box-shadow: 0 8px 25px rgba(34,21,112,0.22); }
.dock-separator { background-color: rgba(85,78,153,0.23); min-width: 1px; margin: 9px 6px; }
.launcher { border-radius: 13px; padding: 8px; }
.launcher:hover { background-color: rgba(202,216,255,0.20); }
.launcher:active { background-color: rgba(202,216,255,0.32); }
.start {
  background-image: linear-gradient(to bottom right, {{accent_blue}}, {{accent_purple}});
  color: {{text_on_dark}}; border-radius: 17px; border: 1px solid rgba(255,255,255,0.35);
  padding: 0px; margin: 0px;
  box-shadow: inset 0 1px rgba(255,255,255,0.31), 0 5px 16px rgba(60,61,145,0.30);
}
.start:hover { background-image: linear-gradient(to bottom right, #79A6FF, #A18AF8); }
.start:active { background-image: linear-gradient(to bottom right, #456DE3, #7354CA); }
.clock {
  background-color: rgba(222,217,255,0.88); border-radius: 17px;
  border: 1px solid rgba(255,255,255,0.56); padding: 9px 15px;
  box-shadow: 0 6px 18px rgba(34,21,112,0.18);
}
.clock-time { font-size: 17px; font-weight: 700; color: {{panel_text}}; }
.clock-date { font-size: 12px; color: {{panel_muted}}; }
.desktop-tile { background-color: transparent; border-radius: 18px; padding: 7px 5px; }
.desktop-tile:hover { background-color: rgba(234,240,255,0.25); }
.desktop-label { font-size: 13px; font-weight: 700; color: #F6F9FF; text-shadow: 0 1px 3px rgba(10,21,61,0.78); }
.notch {
  background-color: {{notch_black}}; border-radius: 0 0 22px 22px; border: 1px solid rgba(255,255,255,0.045);
  padding: 0 9px 5px 9px; box-shadow: 0 8px 22px rgba(4,7,24,0.24);
}
.notch-cap { background-color: transparent; min-width: 126px; min-height: 23px; }
.notch-content { padding: 13px 17px 17px 17px; min-width: 305px; }
.notch-title { color: {{text_on_dark}}; font-size: 15px; font-weight: 700; }
.notch-subtitle { color: {{text_muted}}; font-size: 12px; }
.notch-row { margin: 4px 0 5px 0; }
.notch-label { color: {{text_muted}}; font-size: 12px; font-weight: 600; }
.notch-chip { background-color: rgba(227,234,255,0.12); color: {{text_on_dark}}; border-radius: 12px; padding: 10px 12px; border: 0; }
.notch-chip:hover { background-color: rgba(145,171,255,0.27); }
.notch-divider { background-color: rgba(236,243,255,0.11); min-height: 1px; margin: 9px 0; }
.menu {
  background-color: rgba(224,219,255,0.93); color: {{panel_text}};
  border: 1px solid rgba(255,255,255,0.64);
  border-radius: 26px; padding: 24px;
  box-shadow: 0 14px 42px rgba(30,22,107,0.28), inset 0 1px rgba(255,255,255,0.42);
}
.menu-title { color: {{panel_text}}; font-size: 24px; font-weight: 800; }
.menu-subtitle { color: {{panel_muted}}; font-size: 13px; }
.menu-section { color: {{panel_text}}; font-size: 14px; font-weight: 700; margin-top: 5px; }
.menu-divider { background-color: rgba(74,66,130,0.17); min-height: 1px; margin: 2px 0 6px 0; }
.menu searchentry, .menu entry {
  background-image: none; background-color: rgba(255,255,255,0.48); color: {{panel_text}};
  border: 1px solid rgba(98,87,170,0.22); border-radius: 14px;
  padding: 10px 13px; min-height: 34px; box-shadow: none; caret-color: {{panel_text}};
}
.menu searchentry:focus, .menu entry:focus { border-color: {{accent_blue}}; }
.app-tile { background-color: transparent; color: {{panel_text}}; border: 0; border-radius: 16px; padding: 9px 3px; }
.app-tile:hover { background-color: rgba(255,255,255,0.33); }
.app-name { color: {{panel_text}}; font-size: 13px; }
.quick-tile {
  background-color: rgba(255,255,255,0.26);
  border: 1px solid rgba(255,255,255,0.36); border-radius: 15px; padding: 10px 8px;
}
.quick-tile:hover { background-color: rgba(255,255,255,0.45); }
.quick-label { color: {{panel_text}}; font-size: 14px; font-weight: 600; }
.menu-footer button { background-color: rgba(255,255,255,0.32); border: 0; border-radius: 12px; padding: 11px 15px; color: {{panel_text}}; }
.menu-footer button:hover { background-color: rgba(255,255,255,0.48); }
scale trough { background-color: #3A4867; border-radius: 8px; min-height: 5px; }
scale highlight { background-color: {{accent_blue}}; border-radius: 8px; }
scale slider { background-color: {{text_on_dark}}; border: 0; border-radius: 50%; min-height: 15px; min-width: 15px; }

/* Stage 6 polish: compact hub; six real tabs never stretch the window. */
.notch { border-radius: 0 0 22px 22px; background-color: {{notch_black}}; padding: 0 5px 3px; }
.notch-content { padding: 11px 12px 13px; min-width: 0; }
.notch-heading { margin-bottom: 1px; }
.notch-heading .notch-chip { padding: 5px 9px; border-radius: 9px; }
.notch-tabs { margin-bottom: 4px; }
.notch-tabs button {
  border: 0; border-radius: 9px; padding: 5px 2px;
  min-height: 29px; font-size: 11px;
  color: {{text_muted}}; background-color: transparent;
}
.notch-tabs button:checked {
  background-color: rgba(137,155,239,0.25);
  color: {{text_on_dark}};
}
.notch-page { padding: 7px 2px 2px; min-height: 124px; }
.notch-section-title { color: {{text_on_dark}}; font-size: 16px; font-weight: 700; }
.notch-page .notch-chip { min-height: 31px; padding: 8px 10px; }
.notch-page scale trough { min-height: 6px; }
.notch-page scale slider { min-height: 17px; min-width: 17px; }
