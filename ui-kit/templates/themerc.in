border.width: 1
padding.height: 4
titlebar.height: {{titlebar_height_px}}
window.active.border.color: #AEBFE2
window.inactive.border.color: #CED9EB
window.active.title.bg.color: {{app_header}}
window.inactive.title.bg.color: #F2F4FA
window.active.label.text.color: {{app_text}}
window.inactive.label.text.color: {{app_muted}}
window.label.text.justify: Left
window.button.width: 20
window.button.height: 20
window.button.spacing: 6
window.active.button.unpressed.image.color: #4C5B80
window.inactive.button.unpressed.image.color: #9BA8C0
menu.items.bg.color: {{app_surface}}
menu.items.text.color: {{app_text}}
menu.items.active.bg.color: {{accent_light}}
menu.items.active.text.color: #334EB0
osd.bg.color: {{app_header}}
osd.label.text.color: {{app_text}}
